---
const navLinks = [
  { label: 'Nosotros', href: '#nosotros' },
  { label: 'Misión y Visión', href: '#mision' },
  { label: 'Programas', href: '#programas' },
  { label: 'Noticias', href: '#noticias' },
  { label: 'Contacto', href: '#contacto' },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md shadow-sm border-b border-stone-100">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">

      <!-- Logo -->
      <a href="/" class="flex items-center flex-shrink-0">
        <img
          src="/logo.svg"
          alt="Logo SBN Chile"
          class="h-8 md:h-10 w-auto"
        />
      </a>

      <!-- Desktop nav -->
      <ul class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="px-4 py-2 text-sm font-medium text-warmgray hover:text-nazarene-700 hover:bg-nazarene-50 rounded-lg transition-colors duration-200"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA desktop -->
      <a
        href="#contacto"
        class="hidden md:inline-flex items-center px-5 py-2.5 bg-nazarene-600 text-white text-sm font-semibold rounded-lg hover:bg-nazarene-700 transition-colors duration-200 shadow-sm"
      >
        Postula ahora
      </a>

      <!-- Mobile hamburger (CSS-only checkbox hack) -->
      <label for="mobile-menu-toggle" class="md:hidden cursor-pointer p-2 rounded-lg hover:bg-stone-100 transition-colors" aria-label="Abrir menú">
        <svg class="h-6 w-6 text-charcoal" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </label>
    </div>
  </nav>

  <!-- Mobile menu checkbox (hidden) -->
  <input type="checkbox" id="mobile-menu-toggle" class="peer sr-only" />

  <!-- Mobile menu -->
  <div class="md:hidden max-h-0 overflow-hidden peer-checked:max-h-screen transition-all duration-300 ease-in-out bg-white border-t border-stone-100">
    <nav class="max-w-7xl mx-auto px-4 py-4 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block px-4 py-3 text-base font-medium text-warmgray hover:text-nazarene-700 hover:bg-nazarene-50 rounded-lg transition-colors duration-200"
          onclick="document.getElementById('mobile-menu-toggle').checked = false;"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-2 pb-1">
        <a
          href="#contacto"
          class="block w-full text-center px-4 py-3 bg-nazarene-600 text-white font-semibold rounded-lg hover:bg-nazarene-700 transition-colors duration-200"
        >
          Postula ahora
        </a>
      </div>
    </nav>
  </div>
</header>
