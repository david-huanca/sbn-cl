---
import { site } from '../../data/site';

const year = new Date().getFullYear();
---

<footer style="background:var(--bg); border-top:1px solid var(--line); padding:clamp(56px,7vw,88px) 28px 40px;">
  <div style="max-width:1200px; margin:0 auto;">
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap:clamp(32px,4vw,56px);">

      <div>
        <img src="/logo.svg" alt="Seminario Bíblico Nazareno de Chile" style="height:34px; width:auto; display:block;" />
        <p style="font-family:'Cormorant Garamond',serif; font-style:italic; font-size:1.25rem; color:var(--muted); margin:24px 0 0; max-width:22em;">
          Formando líderes para la misión del Reino.
        </p>
      </div>

      <div>
        <div style="font-size:12px; text-transform:uppercase; letter-spacing:.18em; color:var(--accent); margin-bottom:18px;">Navegación</div>
        <div style="display:flex; flex-direction:column; gap:12px;">
          <a href="#nosotros" style="text-decoration:none; color:var(--ink); font-size:16px; transition:color .2s;"
             onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--ink)'">Nosotros</a>
          <a href="#mision" style="text-decoration:none; color:var(--ink); font-size:16px; transition:color .2s;"
             onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--ink)'">Misión y Visión</a>
          <a href="#programas" style="text-decoration:none; color:var(--ink); font-size:16px; transition:color .2s;"
             onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--ink)'">Programas</a>
          <a href="#contacto" style="text-decoration:none; color:var(--ink); font-size:16px; transition:color .2s;"
             onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--ink)'">Contacto</a>
        </div>
      </div>

      <div>
        <div style="font-size:12px; text-transform:uppercase; letter-spacing:.18em; color:var(--accent); margin-bottom:18px;">Programas</div>
        <div style="display:flex; flex-direction:column; gap:12px;">
          <a href="#programas" style="text-decoration:none; color:var(--ink); font-size:16px; transition:color .2s;"
             onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--ink)'">Licenciatura en Teología</a>
          <a href="#programas" style="text-decoration:none; color:var(--ink); font-size:16px; transition:color .2s;"
             onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--ink)'">Bachillerato en Teología</a>
        </div>
      </div>

      <div>
        <div style="font-size:12px; text-transform:uppercase; letter-spacing:.18em; color:var(--accent); margin-bottom:18px;">Síguenos</div>
        <div style="display:flex; flex-direction:column; gap:12px;">
          <a href={site.social.facebook} style="text-decoration:none; color:var(--ink); font-size:16px; transition:color .2s;"
             onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--ink)'">Facebook</a>
          <a href={site.social.instagram} style="text-decoration:none; color:var(--ink); font-size:16px; transition:color .2s;"
             onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--ink)'">Instagram</a>
          <a href={site.social.youtube} style="text-decoration:none; color:var(--ink); font-size:16px; transition:color .2s;"
             onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--ink)'">YouTube</a>
        </div>
      </div>

    </div>

    <div style="display:flex; flex-wrap:wrap; justify-content:space-between; gap:16px; margin-top:clamp(40px,5vw,64px); padding-top:28px; border-top:1px solid var(--line);">
      <span style="font-size:13.5px; color:var(--muted);">© {year} Seminario Bíblico Nazareno de Chile. Todos los derechos reservados.</span>
      <div style="display:flex; gap:24px;">
        <a href="/politica-de-privacidad" style="font-size:13.5px; color:var(--muted); text-decoration:none;"
           onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--muted)'">Política de Privacidad</a>
        <a href="/condiciones-del-servicio" style="font-size:13.5px; color:var(--muted); text-decoration:none;"
           onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--muted)'">Condiciones del Servicio</a>
      </div>
    </div>
  </div>
</footer>
