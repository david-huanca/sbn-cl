---
interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className = '', hover = false } = Astro.props;

const base = 'bg-white rounded-xl shadow-md overflow-hidden';
const hoverClass = hover ? 'hover:shadow-xl hover:-translate-y-1 transition-all duration-300' : '';
const classes = [base, hoverClass, className].join(' ');
---

<div class={classes}>
  <slot />
</div>
