---
interface Props {
  title: string;
  subtitle?: string;
  centered?: boolean;
  light?: boolean;
}

const { title, subtitle, centered = true, light = false } = Astro.props;

const titleClass = light ? 'text-white' : 'text-charcoal';
const subtitleClass = light ? 'text-nazarene-200' : 'text-warmgray';
const accentClass = light ? 'bg-gold-400' : 'bg-nazarene-600';
const alignClass = centered ? 'text-center items-center' : 'text-left items-start';
---

<div class={`flex flex-col ${alignClass} mb-12`}>
  <div class={`h-1 w-12 rounded-full ${accentClass} mb-4`}></div>
  <h2 class={`font-serif text-3xl md:text-4xl font-bold ${titleClass} text-balance`}>
    {title}
  </h2>
  {subtitle && (
    <p class={`mt-4 text-lg max-w-2xl ${subtitleClass}`}>
      {subtitle}
    </p>
  )}
</div>
