---
import SectionTitle from '../ui/SectionTitle.astro';
---

<section id="cursos" class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <SectionTitle
      title="Cursos y Horarios"
      subtitle="Conoce los cursos que están en curso y los próximos a comenzar."
    />

    <!-- Tabs -->
    <div id="cursos-tabs" class="flex gap-2 mb-10 border-b border-stone-200">
      <button
        class="tab-btn px-6 py-3 text-sm font-semibold border-b-2 border-nazarene-600 text-nazarene-700 -mb-px transition-colors duration-200"
        data-tab="en-progreso"
      >
        En Progreso
      </button>
      <button
        class="tab-btn px-6 py-3 text-sm font-semibold border-b-2 border-transparent text-warmgray hover:text-charcoal -mb-px transition-colors duration-200"
        data-tab="inscripciones"
      >
        Inscripciones Abiertas
      </button>
      <button
        class="tab-btn px-6 py-3 text-sm font-semibold border-b-2 border-transparent text-warmgray hover:text-charcoal -mb-px transition-colors duration-200"
        data-tab="proximamente"
      >
        Próximamente
      </button>
    </div>

    <!-- Loading state -->
    <div id="cursos-loading" class="flex flex-col items-center justify-center py-16 text-warmgray gap-3">
      <svg class="h-8 w-8 animate-spin text-nazarene-400" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      <span class="text-sm">Cargando cursos...</span>
    </div>

    <!-- Error state -->
    <div id="cursos-error" class="hidden flex-col items-center justify-center py-16 text-warmgray gap-3">
      <svg class="h-10 w-10 text-stone-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
      </svg>
      <p class="text-sm">No se pudo cargar la información. Intenta más tarde.</p>
    </div>

    <!-- Empty state -->
    <div id="cursos-empty" class="hidden flex-col items-center justify-center py-16 text-warmgray gap-3">
      <svg class="h-10 w-10 text-stone-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
      </svg>
      <p class="text-sm">No hay cursos disponibles en esta categoría.</p>
    </div>

    <!-- Sub-tabs de mes (Próximamente) -->
    <div id="mes-tabs" class="hidden flex-wrap gap-2 mb-8"></div>

    <!-- Grid de cursos -->
    <div id="cursos-grid" class="hidden grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>

  </div>
</section>

<script>
  interface Session {
    id: number;
    date: string;
    durationHours: string;
    timezone: string;
    link?: string;
  }

  interface ScheduleItem {
    id: number;
    type: string;
    status: string;
    initDate: string;
    endDate: string;
    zoomJoinUrl?: string;
    course: {
      id: number;
      name: string;
      area: string;
      type: string;
      block: string;
      duration: string;
      credits: number;
      image?: string;
    };
    program: { id: number; name: string; year: number };
    center: { id: number; name: string; district: { id: number; name: string } };
    teacher: { id: number; name: string };
    sessions: Session[];
    enrolledCount?: number;
  }

  interface ApiResponse {
    success: boolean;
    data: {
      classrooms: ScheduleItem[];
    };
  }

  const STATUS_INSCRIPCION = 'Inicio Inscripciones';
  const STATUS_CREADA = 'Creada';

  let enProgreso: ScheduleItem[] = [];
  let inscripciones: ScheduleItem[] = [];
  let proximamente: ScheduleItem[] = [];
  let activeTab = 'en-progreso';

  const loading = document.getElementById('cursos-loading')!;
  const errorEl = document.getElementById('cursos-error')!;
  const empty = document.getElementById('cursos-empty')!;
  const grid = document.getElementById('cursos-grid')!;
  const mesTabs = document.getElementById('mes-tabs')!;
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');

  let activeMes = '';

  function formatDate(dateStr: string): string {
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return dateStr;
    return d.toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
  }

  function showState(state: 'loading' | 'error' | 'empty' | 'grid') {
    for (const el of [loading, errorEl, empty]) {
      el.classList.add('hidden');
      el.classList.remove('flex');
    }
    grid.classList.add('hidden');
    grid.classList.remove('grid');

    if (state === 'loading') {
      loading.classList.remove('hidden');
      loading.classList.add('flex');
    } else if (state === 'error') {
      errorEl.classList.remove('hidden');
      errorEl.classList.add('flex');
    } else if (state === 'empty') {
      empty.classList.remove('hidden');
      empty.classList.add('flex');
    } else {
      grid.classList.remove('hidden');
      grid.classList.add('grid');
    }
  }

  function nextSessionDate(sessions: Session[]): string {
    const sorted = sessions
      .map((s) => new Date(s.date))
      .filter((d) => !isNaN(d.getTime()))
      .sort((a, b) => a.getTime() - b.getTime());
    if (sorted.length === 0) return '';
    const next = sorted.find((d) => d >= new Date()) ?? sorted[sorted.length - 1];
    return next.toLocaleDateString('es-CL', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });
  }

  type TabType = 'en-progreso' | 'inscripciones' | 'proximamente';

  function buildCard(item: ScheduleItem, tab: TabType): string {
    const badgeHtml =
      tab === 'en-progreso'
        ? '<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200">En progreso</span>'
        : tab === 'inscripciones'
          ? '<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide bg-sky-50 text-sky-700 ring-1 ring-sky-200">Inscripciones abiertas</span>'
          : '<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide bg-amber-50 text-amber-700 ring-1 ring-amber-200">Próximamente</span>';

    const nextSession = nextSessionDate(item.sessions);

    const imageHtml = item.course.image
      ? `<img src="${item.course.image}" alt="${item.course.name}" class="w-full object-contain bg-stone-50" loading="lazy" />`
      : `<div class="h-2 bg-nazarene-600"></div>`;

    return `
      <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col">
        ${imageHtml}
        <div class="p-6 flex flex-col flex-1">

          <div class="flex items-start justify-between gap-3 mb-4">
            ${badgeHtml}
            <span class="text-xs text-warmgray bg-stone-50 px-2 py-1 rounded-md ring-1 ring-stone-200 whitespace-nowrap">${item.type}</span>
          </div>

          ${!item.course.image ? `<h3 class="font-serif text-lg font-bold text-charcoal mb-1 leading-snug">${item.course.name}</h3>` : ''}

          <p class="text-xs text-nazarene-600 font-medium mb-4">${item.program.name}</p>

          <div class="flex flex-wrap gap-2 mb-4">
            <span class="text-xs bg-stone-100 text-warmgray px-2 py-0.5 rounded">${item.course.area}</span>
            <span class="text-xs bg-stone-100 text-warmgray px-2 py-0.5 rounded">${item.course.block}</span>
            <span class="text-xs bg-stone-100 text-warmgray px-2 py-0.5 rounded">${item.course.credits} créditos</span>
          </div>

          <div class="flex-1"></div>

          <div class="pt-4 border-t border-stone-100 space-y-2">
            <div class="flex items-center gap-2 text-xs text-warmgray">
              <svg class="h-4 w-4 text-nazarene-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span>${item.teacher.name}</span>
            </div>

            <div class="flex items-center gap-2 text-xs text-warmgray">
              <svg class="h-4 w-4 text-nazarene-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>${formatDate(item.initDate)} — ${formatDate(item.endDate)}</span>
            </div>

            <div class="flex items-center gap-2 text-xs text-warmgray">
              <svg class="h-4 w-4 text-nazarene-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>${item.center.name} — Distrito ${item.center.district.name}</span>
            </div>

            ${nextSession ? `
            <div class="flex items-center gap-2 text-xs text-warmgray">
              <svg class="h-4 w-4 text-nazarene-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Próx. sesión: ${nextSession}</span>
            </div>` : ''}
          </div>
        </div>
      </div>
    `;
  }

  function monthKey(item: ScheduleItem): string {
    const d = new Date(item.initDate);
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  }

  function monthLabel(key: string): string {
    const [year, month] = key.split('-');
    const d = new Date(Number(year), Number(month) - 1, 1);
    return d.toLocaleDateString('es-CL', { month: 'long' });
  }

  function renderMesTabs(months: string[]) {
    mesTabs.innerHTML = months.map((m, i) => `
      <button
        class="mes-btn px-4 py-2 text-sm font-semibold rounded-lg transition-colors duration-200 ${i === 0 ? 'bg-nazarene-600 text-white' : 'bg-stone-100 text-warmgray hover:bg-stone-200'}"
        data-mes="${m}"
      >
        ${monthLabel(m)}
      </button>
    `).join('');

    mesTabs.querySelectorAll<HTMLButtonElement>('.mes-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeMes = btn.dataset.mes!;
        mesTabs.querySelectorAll<HTMLButtonElement>('.mes-btn').forEach((b) => {
          const isActive = b.dataset.mes === activeMes;
          b.classList.toggle('bg-nazarene-600', isActive);
          b.classList.toggle('text-white', isActive);
          b.classList.toggle('bg-stone-100', !isActive);
          b.classList.toggle('text-warmgray', !isActive);
        });
        renderProximamentePorMes();
      });
    });
  }

  function renderProximamentePorMes() {
    const filtered = proximamente.filter((c) => monthKey(c) === activeMes);
    grid.innerHTML = filtered.map((c) => buildCard(c, 'proximamente')).join('');
    showState('grid');
  }

  function hideMesTabs() {
    mesTabs.classList.add('hidden');
    mesTabs.classList.remove('flex');
  }

  function renderCourses(tab: string) {
    const courses = tab === 'en-progreso' ? enProgreso : tab === 'inscripciones' ? inscripciones : proximamente;

    if (courses.length === 0) {
      hideMesTabs();
      showState('empty');
      return;
    }

    if (tab === 'en-progreso') {
      hideMesTabs();
      grid.innerHTML = courses.map((c) => buildCard(c, 'en-progreso')).join('');
      showState('grid');
    } else if (tab === 'inscripciones') {
      hideMesTabs();
      grid.innerHTML = courses.map((c) => buildCard(c, 'inscripciones')).join('');
      showState('grid');
    } else {
      const months = [...new Set(proximamente.map(monthKey))].sort();
      activeMes = months[0];
      renderMesTabs(months);
      mesTabs.classList.remove('hidden');
      mesTabs.classList.add('flex');
      renderProximamentePorMes();
    }
  }

  function setActiveTab(tab: string) {
    activeTab = tab;
    tabs.forEach((btn) => {
      const isActive = btn.dataset.tab === tab;
      btn.classList.toggle('border-nazarene-600', isActive);
      btn.classList.toggle('text-nazarene-700', isActive);
      btn.classList.toggle('border-transparent', !isActive);
      btn.classList.toggle('text-warmgray', !isActive);
    });
    renderCourses(tab);
  }

  tabs.forEach((btn) => {
    btn.addEventListener('click', () => setActiveTab(btn.dataset.tab!));
  });

  async function loadCourses() {
    showState('loading');
    try {
      const res = await fetch('/api/courses-schedule');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json: ApiResponse = await res.json();
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      const all = (json.data?.classrooms ?? []).filter((c: ScheduleItem) => new Date(c.endDate) >= today);
      enProgreso = all.filter((c: ScheduleItem) => c.status === 'En progreso');
      inscripciones = all.filter((c: ScheduleItem) => c.status === STATUS_INSCRIPCION);
      proximamente = all.filter((c: ScheduleItem) => c.status === STATUS_CREADA);

      const tabEnProgreso = document.querySelector<HTMLButtonElement>('[data-tab="en-progreso"]');
      tabEnProgreso?.classList.toggle('hidden', enProgreso.length === 0);

      if (enProgreso.length > 0) {
        setActiveTab('en-progreso');
      } else if (inscripciones.length > 0) {
        setActiveTab('inscripciones');
      } else {
        setActiveTab('proximamente');
      }
    } catch (e) {
      console.error('[cursos]', e);
      showState('error');
    }
  }

  loadCourses();
</script>
