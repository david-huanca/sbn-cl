---
---

<section id="cursos" style="scroll-margin-top:90px; padding:clamp(72px,10vw,140px) 28px;">
  <div style="max-width:1200px; margin:0 auto;">

    <div style="max-width:620px;">
      <div style="font-size:13px; text-transform:uppercase; letter-spacing:.24em; color:var(--accent); font-weight:600;">04 — Cursos y Horarios</div>
      <h2 style="font-family:'Cormorant Garamond',serif; font-weight:600; font-size:clamp(2.3rem,4.5vw,3.6rem); line-height:1.05; letter-spacing:-0.01em; margin:22px 0 0; color:var(--ink);">
        Cursos en curso y próximos a comenzar
      </h2>
    </div>

    <!-- Tabs -->
    <div id="cursos-tabs" style="display:flex; flex-wrap:wrap; gap:10px; margin-top:44px; border-bottom:1px solid var(--line); padding-bottom:0;">
      <button class="tab-btn"
        style="background:none; border:none; cursor:pointer; font-family:'Newsreader',serif; font-size:16px; padding:14px 4px; margin-bottom:-1px; transition:color .2s; border-bottom:2px solid var(--accent); color:var(--ink);"
        data-tab="en-progreso">En Progreso</button>
      <button class="tab-btn"
        style="background:none; border:none; cursor:pointer; font-family:'Newsreader',serif; font-size:16px; padding:14px 4px; margin-bottom:-1px; transition:color .2s; border-bottom:2px solid transparent; color:var(--muted);"
        data-tab="inscripciones">Inscripciones Abiertas</button>
      <button class="tab-btn"
        style="background:none; border:none; cursor:pointer; font-family:'Newsreader',serif; font-size:16px; padding:14px 4px; margin-bottom:-1px; transition:color .2s; border-bottom:2px solid transparent; color:var(--muted);"
        data-tab="proximamente">Próximamente</button>
    </div>

    <!-- Loading state -->
    <div id="cursos-loading" style="display:flex; flex-direction:column; align-items:center; justify-content:center; padding:64px 0; color:var(--muted); gap:12px;">
      <svg style="width:32px; height:32px; animation:spin 1s linear infinite; color:var(--accent);" fill="none" viewBox="0 0 24 24">
        <circle style="opacity:.25;" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path style="opacity:.75;" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      <span style="font-size:14px;">Cargando cursos...</span>
    </div>

    <!-- Error state -->
    <div id="cursos-error" style="display:none; flex-direction:column; align-items:center; justify-content:center; padding:64px 0; color:var(--muted); gap:12px;">
      <svg style="width:40px; height:40px; color:var(--line);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
      </svg>
      <p style="font-size:14px;">No se pudo cargar la información. Intenta más tarde.</p>
    </div>

    <!-- Empty state -->
    <div id="cursos-empty" style="display:none; flex-direction:column; align-items:center; justify-content:center; padding:64px 0; color:var(--muted); gap:12px;">
      <svg style="width:40px; height:40px; color:var(--line);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
      </svg>
      <p style="font-size:14px;">No hay cursos disponibles en esta categoría.</p>
    </div>

    <!-- Sub-tabs de mes (Próximamente) -->
    <div id="mes-tabs" class="hidden" style="flex-wrap:wrap; gap:8px; margin-bottom:32px;"></div>

    <!-- Grid de cursos -->
    <div id="cursos-grid" class="hidden" style="grid-template-columns:repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap:clamp(16px,2vw,24px); margin-top:40px;"></div>

  </div>
</section>

<style>
  @keyframes spin { to { transform: rotate(360deg); } }
  #cursos-grid.grid { display: grid; }
  #mes-tabs.flex { display: flex; }
</style>

<script>
  interface Session {
    id: number;
    date: string;
    durationHours: string;
    timezone: string;
    link?: string;
  }

  interface ScheduleItem {
    id: number;
    type: string;
    status: string;
    initDate: string;
    endDate: string;
    zoomJoinUrl?: string;
    course: {
      id: number;
      name: string;
      area: string;
      type: string;
      block: string;
      duration: string;
      credits: number;
      image?: string;
    };
    program: { id: number; name: string; year: number };
    center: { id: number; name: string; district: { id: number; name: string } };
    teacher: { id: number; name: string };
    sessions: Session[];
    enrolledCount?: number;
  }

  interface ApiResponse {
    success: boolean;
    data: {
      classrooms: ScheduleItem[];
    };
  }

  const STATUS_INSCRIPCION = 'Inicio Inscripciones';
  const STATUS_CREADA = 'Creada';

  let enProgreso: ScheduleItem[] = [];
  let inscripciones: ScheduleItem[] = [];
  let proximamente: ScheduleItem[] = [];
  let activeTab = 'en-progreso';

  const loading = document.getElementById('cursos-loading')!;
  const errorEl = document.getElementById('cursos-error')!;
  const empty = document.getElementById('cursos-empty')!;
  const grid = document.getElementById('cursos-grid')!;
  const mesTabs = document.getElementById('mes-tabs')!;
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');

  let activeMes = '';

  function formatDate(dateStr: string): string {
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return dateStr;
    return d.toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
  }

  function showState(state: 'loading' | 'error' | 'empty' | 'grid') {
    for (const el of [loading, errorEl, empty]) {
      el.classList.add('hidden');
      el.classList.remove('flex');
    }
    grid.classList.add('hidden');
    grid.classList.remove('grid');

    if (state === 'loading') {
      loading.classList.remove('hidden');
      loading.classList.add('flex');
    } else if (state === 'error') {
      errorEl.classList.remove('hidden');
      errorEl.classList.add('flex');
    } else if (state === 'empty') {
      empty.classList.remove('hidden');
      empty.classList.add('flex');
    } else {
      grid.classList.remove('hidden');
      grid.classList.add('grid');
    }
  }

  function nextSessionDate(sessions: Session[]): string {
    const sorted = sessions
      .map((s) => new Date(s.date))
      .filter((d) => !isNaN(d.getTime()))
      .sort((a, b) => a.getTime() - b.getTime());
    if (sorted.length === 0) return '';
    const next = sorted.find((d) => d >= new Date()) ?? sorted[sorted.length - 1];
    return next.toLocaleDateString('es-CL', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });
  }

  type TabType = 'en-progreso' | 'inscripciones' | 'proximamente';

  function buildCard(item: ScheduleItem, tab: TabType): string {
    const badge =
      tab === 'en-progreso' ? 'En curso'
      : tab === 'inscripciones' ? 'Inscríbete'
      : 'Próximo';

    const nextSession = nextSessionDate(item.sessions);

    const imageHtml = item.course.image
      ? `<img src="${item.course.image}" alt="${item.course.name}" style="width:100%; object-fit:contain; background:var(--surface);" loading="lazy" />`
      : '';

    return `
      <article style="background:var(--surface); border:1px solid var(--line); padding:28px; display:flex; flex-direction:column; transition:border-color .25s;">
        ${imageHtml}
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px; ${imageHtml ? 'margin-top:16px;' : ''}">
          <span style="font-size:11px; text-transform:uppercase; letter-spacing:.16em; color:var(--accent); background:var(--accent-soft); padding:5px 10px;">${badge}</span>
          <span style="font-size:12px; letter-spacing:.1em; color:var(--muted);">${item.type}</span>
        </div>
        <h3 style="font-family:'Cormorant Garamond',serif; font-weight:600; font-size:1.55rem; line-height:1.15; color:var(--ink); margin:18px 0 0;">${item.course.name}</h3>
        <p style="font-size:12px; color:var(--accent); margin:6px 0 0;">${item.program.name}</p>
        <div style="display:flex; flex-direction:column; gap:10px; margin-top:20px; padding-top:18px; border-top:1px solid var(--line);">
          <div style="display:flex; justify-content:space-between; font-size:14px;"><span style="color:var(--muted);">Profesor</span><span style="color:var(--ink);">${item.teacher.name}</span></div>
          <div style="display:flex; justify-content:space-between; font-size:14px;"><span style="color:var(--muted);">Período</span><span style="color:var(--ink);">${formatDate(item.initDate)} — ${formatDate(item.endDate)}</span></div>
          <div style="display:flex; justify-content:space-between; font-size:14px;"><span style="color:var(--muted);">Centro</span><span style="color:var(--ink); text-align:right; max-width:60%;">${item.center.name}</span></div>
          ${nextSession ? `<div style="display:flex; justify-content:space-between; font-size:14px;"><span style="color:var(--muted);">Próx. sesión</span><span style="color:var(--ink); text-align:right; max-width:60%;">${nextSession}</span></div>` : ''}
        </div>
      </article>
    `;
  }

  function monthKey(item: ScheduleItem): string {
    const d = new Date(item.initDate);
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  }

  function monthLabel(key: string): string {
    const [year, month] = key.split('-');
    const d = new Date(Number(year), Number(month) - 1, 1);
    return d.toLocaleDateString('es-CL', { month: 'long' });
  }

  function renderMesTabs(months: string[]) {
    mesTabs.innerHTML = months.map((m, i) => `
      <button class="mes-btn" data-mes="${m}"
        style="background:none; border:none; cursor:pointer; font-family:'Newsreader',serif; font-size:14px; padding:8px 18px; transition:all .2s; border-bottom:2px solid ${i === 0 ? 'var(--accent)' : 'transparent'}; color:${i === 0 ? 'var(--ink)' : 'var(--muted)'};">
        ${monthLabel(m)}
      </button>
    `).join('');

    mesTabs.querySelectorAll<HTMLButtonElement>('.mes-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeMes = btn.dataset.mes!;
        mesTabs.querySelectorAll<HTMLButtonElement>('.mes-btn').forEach((b) => {
          const isActive = b.dataset.mes === activeMes;
          b.style.borderBottomColor = isActive ? 'var(--accent)' : 'transparent';
          b.style.color = isActive ? 'var(--ink)' : 'var(--muted)';
        });
        renderProximamentePorMes();
      });
    });
  }

  function renderProximamentePorMes() {
    const filtered = proximamente.filter((c) => monthKey(c) === activeMes);
    grid.innerHTML = filtered.map((c) => buildCard(c, 'proximamente')).join('');
    showState('grid');
  }

  function hideMesTabs() {
    mesTabs.classList.add('hidden');
    mesTabs.classList.remove('flex');
  }

  function renderCourses(tab: string) {
    const courses = tab === 'en-progreso' ? enProgreso : tab === 'inscripciones' ? inscripciones : proximamente;

    if (courses.length === 0) {
      hideMesTabs();
      showState('empty');
      return;
    }

    if (tab === 'en-progreso') {
      hideMesTabs();
      grid.innerHTML = courses.map((c) => buildCard(c, 'en-progreso')).join('');
      showState('grid');
    } else if (tab === 'inscripciones') {
      hideMesTabs();
      grid.innerHTML = courses.map((c) => buildCard(c, 'inscripciones')).join('');
      showState('grid');
    } else {
      const months = [...new Set(proximamente.map(monthKey))].sort();
      activeMes = months[0];
      renderMesTabs(months);
      mesTabs.classList.remove('hidden');
      mesTabs.classList.add('flex');
      renderProximamentePorMes();
    }
  }

  function setActiveTab(tab: string) {
    activeTab = tab;
    tabs.forEach((btn) => {
      const isActive = btn.dataset.tab === tab;
      btn.style.borderBottomColor = isActive ? 'var(--accent)' : 'transparent';
      btn.style.color = isActive ? 'var(--ink)' : 'var(--muted)';
    });
    renderCourses(tab);
  }

  tabs.forEach((btn) => {
    btn.addEventListener('click', () => setActiveTab(btn.dataset.tab!));
  });

  async function loadCourses() {
    showState('loading');
    try {
      const res = await fetch('/api/courses-schedule');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json: ApiResponse = await res.json();
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      const all = (json.data?.classrooms ?? []).filter((c: ScheduleItem) => new Date(c.endDate) >= today);
      enProgreso = all.filter((c: ScheduleItem) => c.status === 'En progreso');
      inscripciones = all.filter((c: ScheduleItem) => c.status === STATUS_INSCRIPCION);
      proximamente = all.filter((c: ScheduleItem) => c.status === STATUS_CREADA);

      const tabEnProgreso = document.querySelector<HTMLButtonElement>('[data-tab="en-progreso"]');
      tabEnProgreso?.classList.toggle('hidden', enProgreso.length === 0);

      if (enProgreso.length > 0) {
        setActiveTab('en-progreso');
      } else if (inscripciones.length > 0) {
        setActiveTab('inscripciones');
      } else {
        setActiveTab('proximamente');
      }
    } catch (e) {
      console.error('[cursos]', e);
      showState('error');
    }
  }

  loadCourses();
</script>
