---
import { programas } from '../../data/programas';
---

<section id="programas" style="scroll-margin-top:90px; padding:clamp(72px,10vw,140px) 28px; background:var(--surface); border-top:1px solid var(--line); border-bottom:1px solid var(--line);">
  <div style="max-width:1200px; margin:0 auto;">

    <div style="max-width:620px;">
      <div style="font-size:13px; text-transform:uppercase; letter-spacing:.24em; color:var(--accent); font-weight:600;">03 — Programas Académicos</div>
      <h2 style="font-family:'Cormorant Garamond',serif; font-weight:600; font-size:clamp(2.3rem,4.5vw,3.6rem); line-height:1.05; letter-spacing:-0.01em; margin:22px 0 0; color:var(--ink);">
        Una formación teológica completa
      </h2>
      <p style="font-size:1.15rem; line-height:1.7; color:var(--muted); margin:20px 0 0;">Adaptada a distintos niveles y vocaciones ministeriales.</p>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap:clamp(20px,2.5vw,32px); margin-top:56px;">
      {programas.map((p) => (
        <article style="background:var(--bg); border:1px solid var(--line); padding:clamp(28px,3vw,44px); display:flex; flex-direction:column; transition:border-color .25s, transform .25s;"
                 onmouseover="this.style.borderColor='var(--accent)';this.style.transform='translateY(-4px)'"
                 onmouseout="this.style.borderColor='var(--line)';this.style.transform=''">
          <span style="align-self:flex-start; font-size:12px; text-transform:uppercase; letter-spacing:.18em; color:var(--accent); background:var(--accent-soft); padding:6px 12px;">
            {p.nivel}
          </span>
          <h3 style="font-family:'Cormorant Garamond',serif; font-weight:600; font-size:clamp(1.7rem,2.6vw,2.2rem); line-height:1.1; color:var(--ink); margin:24px 0 0;">
            {p.titulo}
          </h3>
          <p style="font-size:1.08rem; line-height:1.7; color:var(--muted); margin:16px 0 0;">{p.descripcion}</p>
          <div style="display:flex; gap:24px; margin-top:28px; padding-top:24px; border-top:1px solid var(--line);">
            <div>
              <div style="font-size:11px; text-transform:uppercase; letter-spacing:.16em; color:var(--muted);">Duración</div>
              <div style="font-family:'Cormorant Garamond',serif; font-size:1.4rem; color:var(--ink); margin-top:4px;">{p.duracion}</div>
            </div>
            <div>
              <div style="font-size:11px; text-transform:uppercase; letter-spacing:.16em; color:var(--muted);">Modalidad</div>
              <div style="font-family:'Cormorant Garamond',serif; font-size:1.4rem; color:var(--ink); margin-top:4px;">{p.modalidad}</div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div style="margin-top:44px;">
      <a href="#contacto"
         style="text-decoration:none; color:var(--ink); font-size:17px; border-bottom:1px solid var(--accent); padding-bottom:5px; transition:color .2s;"
         onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--ink)'">
        Solicitar información de admisiones →
      </a>
    </div>

  </div>
</section>
