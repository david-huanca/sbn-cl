---
import { site } from '../../data/site';
// En desarrollo usar la sitekey de prueba de Cloudflare (siempre pasa, cualquier dominio)
const isDev = import.meta.env.DEV;
const siteKey = isDev
  ? '1x00000000000000000000AA'
  : import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section id="contacto" style="scroll-margin-top:90px; padding:clamp(72px,10vw,140px) 28px; background:var(--surface); border-top:1px solid var(--line);">
  <div style="max-width:1200px; margin:0 auto; display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 400px), 1fr)); gap:clamp(40px,5vw,72px);">

    <!-- Datos de contacto -->
    <div>
      <div style="font-size:13px; text-transform:uppercase; letter-spacing:.24em; color:var(--accent); font-weight:600;">05 — Contáctanos</div>
      <h2 style="font-family:'Cormorant Garamond',serif; font-weight:600; font-size:clamp(2.3rem,4.5vw,3.6rem); line-height:1.05; letter-spacing:-0.01em; margin:22px 0 0; color:var(--ink);">
        Estamos aquí para responder tus preguntas
      </h2>
      <p style="font-size:1.15rem; line-height:1.7; color:var(--muted); margin:22px 0 0; max-width:30em;">
        Sobre nuestros programas académicos y el proceso de admisión.
      </p>

      <div style="display:flex; flex-direction:column; gap:0; margin-top:44px;">
        <div style="display:flex; justify-content:space-between; gap:16px; padding:20px 0; border-top:1px solid var(--line);">
          <span style="font-size:13px; text-transform:uppercase; letter-spacing:.16em; color:var(--muted);">Dirección</span>
          <span style="font-size:16px; color:var(--ink); text-align:right;">{site.address}</span>
        </div>
        <div style="display:flex; justify-content:space-between; gap:16px; padding:20px 0; border-top:1px solid var(--line);">
          <span style="font-size:13px; text-transform:uppercase; letter-spacing:.16em; color:var(--muted);">Correo</span>
          <a href={`mailto:${site.email}`} style="font-size:16px; color:var(--ink); text-decoration:none; border-bottom:1px solid var(--accent);">{site.email}</a>
        </div>
        <div style="display:flex; justify-content:space-between; gap:16px; padding:20px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line);">
          <span style="font-size:13px; text-transform:uppercase; letter-spacing:.16em; color:var(--muted);">Teléfono</span>
          <a href={`tel:${site.phone.replace(/\s+/g, '')}`} style="font-size:16px; color:var(--ink); text-decoration:none; border-bottom:1px solid var(--accent);">{site.phone}</a>
        </div>
        <div style="display:flex; justify-content:space-between; gap:16px; padding:20px 0; border-bottom:1px solid var(--line);">
          <span style="font-size:13px; text-transform:uppercase; letter-spacing:.16em; color:var(--muted);">Horario</span>
          <span style="font-size:16px; color:var(--ink); text-align:right;">Lun a Vie · 9:00 – 18:00</span>
        </div>
      </div>
    </div>

    <!-- Formulario -->
    <div>
      <form id="contacto-form" style="background:var(--bg); border:1px solid var(--line); padding:clamp(28px,3.5vw,44px);">
        <div style="font-family:'Cormorant Garamond',serif; font-size:1.6rem; color:var(--ink); margin-bottom:6px;">Envíanos un mensaje</div>
        <div style="font-size:14px; color:var(--muted); margin-bottom:28px;">Te responderemos a la brevedad posible.</div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(140px, 1fr)); gap:20px;">
          <div style="display:flex; flex-direction:column; gap:7px;">
            <label for="nombre" style="font-size:12px; text-transform:uppercase; letter-spacing:.14em; color:var(--muted);">Nombre *</label>
            <input type="text" id="nombre" name="nombre" required autocomplete="given-name"
                   style="width:100%; padding:12px 14px; border:1px solid var(--line); background:var(--surface); font-family:'Newsreader',serif; font-size:16px; color:var(--ink); outline:none; box-sizing:border-box;"
                   onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--line)'" />
          </div>
          <div style="display:flex; flex-direction:column; gap:7px;">
            <label for="apellido" style="font-size:12px; text-transform:uppercase; letter-spacing:.14em; color:var(--muted);">Apellido *</label>
            <input type="text" id="apellido" name="apellido" required autocomplete="family-name"
                   style="width:100%; padding:12px 14px; border:1px solid var(--line); background:var(--surface); font-family:'Newsreader',serif; font-size:16px; color:var(--ink); outline:none; box-sizing:border-box;"
                   onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--line)'" />
          </div>
          <div style="display:flex; flex-direction:column; gap:7px;">
            <label for="email" style="font-size:12px; text-transform:uppercase; letter-spacing:.14em; color:var(--muted);">Correo electrónico *</label>
            <input type="email" id="email" name="email" required autocomplete="email"
                   style="width:100%; padding:12px 14px; border:1px solid var(--line); background:var(--surface); font-family:'Newsreader',serif; font-size:16px; color:var(--ink); outline:none; box-sizing:border-box;"
                   onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--line)'" />
          </div>
          <div style="display:flex; flex-direction:column; gap:7px;">
            <label for="phone" style="font-size:12px; text-transform:uppercase; letter-spacing:.14em; color:var(--muted);">Teléfono</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel"
                   style="width:100%; padding:12px 14px; border:1px solid var(--line); background:var(--surface); font-family:'Newsreader',serif; font-size:16px; color:var(--ink); outline:none; box-sizing:border-box;"
                   onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--line)'" />
          </div>
          <div style="display:flex; flex-direction:column; gap:7px;">
            <label for="distrito" style="font-size:12px; text-transform:uppercase; letter-spacing:.14em; color:var(--muted);">Distrito</label>
            <input type="text" id="distrito" name="distrito"
                   style="width:100%; padding:12px 14px; border:1px solid var(--line); background:var(--surface); font-family:'Newsreader',serif; font-size:16px; color:var(--ink); outline:none; box-sizing:border-box;"
                   onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--line)'" />
          </div>
          <div style="display:flex; flex-direction:column; gap:7px;">
            <label for="iglesia" style="font-size:12px; text-transform:uppercase; letter-spacing:.14em; color:var(--muted);">Iglesia</label>
            <input type="text" id="iglesia" name="iglesia"
                   style="width:100%; padding:12px 14px; border:1px solid var(--line); background:var(--surface); font-family:'Newsreader',serif; font-size:16px; color:var(--ink); outline:none; box-sizing:border-box;"
                   onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--line)'" />
          </div>
        </div>

        <div style="display:flex; flex-direction:column; gap:7px; margin-top:20px;">
          <label for="tipo" style="font-size:12px; text-transform:uppercase; letter-spacing:.14em; color:var(--muted);">Tipo de contacto *</label>
          <select id="tipo" name="tipo" required
                  style="width:100%; padding:12px 14px; border:1px solid var(--line); background:var(--surface); font-family:'Newsreader',serif; font-size:16px; color:var(--ink); outline:none;"
                  onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--line)'">
            <option value="" disabled selected>Selecciona una opción</option>
            <option value="consulta">Consulta general</option>
            <option value="inscripcion">Inscripción</option>
            <option value="solicitud">Solicitud</option>
          </select>
        </div>

        <div style="display:flex; flex-direction:column; gap:7px; margin-top:20px;">
          <label for="mensaje" style="font-size:12px; text-transform:uppercase; letter-spacing:.14em; color:var(--muted);">Mensaje *</label>
          <textarea id="mensaje" name="mensaje" required rows={4}
                    style="width:100%; padding:12px 14px; border:1px solid var(--line); background:var(--surface); font-family:'Newsreader',serif; font-size:16px; color:var(--ink); outline:none; resize:vertical;"
                    onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--line)'"></textarea>
        </div>

        <div id="form-status" class="hidden" style="font-size:13px; text-align:center; padding:12px 16px; margin-top:16px;"></div>

        <!-- Turnstile captcha -->
        <div id="turnstile-container" style="margin-top:20px;"
             class="cf-turnstile"
             data-sitekey={siteKey}
             data-theme="light"
             data-callback="onTurnstileSuccess"
             data-error-callback="onTurnstileError">
        </div>

        <button type="submit" id="submit-btn" disabled
                style="width:100%; margin-top:28px; background:var(--ink); color:var(--bg); border:none; cursor:pointer; padding:16px; font-family:'Newsreader',serif; font-size:16px; letter-spacing:.02em; transition:filter .2s; display:flex; align-items:center; justify-content:center; gap:8px;"
                onmouseover="this.style.filter='brightness(1.08)'" onmouseout="this.style.filter=''">
          <svg id="submit-icon" style="width:20px; height:20px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
          <span id="submit-text">Enviar mensaje</span>
        </button>
        <p style="font-size:12.5px; color:var(--muted); margin:16px 0 0; text-align:center;">
          Al enviar este formulario, aceptas nuestra <a href="/politica-de-privacidad" style="color:var(--muted); text-decoration:underline;">política de privacidad</a>.
        </p>
      </form>
    </div>

  </div>
</section>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script is:inline>
  // Callbacks globales deben estar definidos antes de que Turnstile cargue
  window.onTurnstileSuccess = function(token) {
    window._turnstileToken = token;
    document.getElementById('submit-btn').disabled = false;
  };
  window.onTurnstileError = function() {
    window._turnstileToken = null;
    document.getElementById('submit-btn').disabled = true;
  };
</script>

<script>
  const form = document.getElementById('contacto-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const submitText = document.getElementById('submit-text') as HTMLSpanElement;
  const submitIcon = document.getElementById('submit-icon') as HTMLElement;
  const statusEl = document.getElementById('form-status') as HTMLDivElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const turnstileToken = (window as any)._turnstileToken as string | null;

    if (!turnstileToken) {
      statusEl.textContent = 'Por favor, completa la verificación de seguridad.';
      statusEl.classList.remove('hidden');
      statusEl.style.cssText = 'font-size:13px; text-align:center; padding:12px 16px; margin-top:16px; background:#fef2f2; color:#B23A3A; border:1px solid #fca5a5;';
      return;
    }

    submitBtn.disabled = true;
    submitText.textContent = 'Enviando...';
    submitIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />';
    statusEl.classList.add('hidden');
    statusEl.style.cssText = '';

    const data = {
      nombre: (form.nombre as HTMLInputElement).value,
      apellido: (form.apellido as HTMLInputElement).value,
      email: (form.email as HTMLInputElement).value,
      phone: (form.phone as HTMLInputElement).value || undefined,
      distrito: (form.distrito as HTMLInputElement).value || undefined,
      iglesia: (form.iglesia as HTMLInputElement).value || undefined,
      tipo: (form.tipo as HTMLSelectElement).value,
      mensaje: (form.mensaje as HTMLTextAreaElement).value,
      turnstileToken,
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        statusEl.textContent = '¡Mensaje enviado! Te responderemos a la brevedad.';
        statusEl.classList.remove('hidden');
        statusEl.style.cssText = 'font-size:13px; text-align:center; padding:12px 16px; margin-top:16px; background:var(--accent-soft); color:var(--ink); border:1px solid var(--accent);';
        form.reset();
        (window as any)._turnstileToken = null;
        submitBtn.disabled = true;
        if ((window as any).turnstile) (window as any).turnstile.reset();
      } else if (res.status === 403) {
        throw new Error('captcha');
      } else {
        throw new Error(`Error ${res.status}`);
      }
    } catch (err: any) {
      const isCaptcha = err?.message === 'captcha';
      statusEl.textContent = isCaptcha
        ? 'Verificación de seguridad fallida. Recarga la página e intenta de nuevo.'
        : 'Ocurrió un error al enviar. Inténtalo nuevamente o escríbenos directamente.';
      statusEl.classList.remove('hidden');
      statusEl.style.cssText = 'font-size:13px; text-align:center; padding:12px 16px; margin-top:16px; background:#fef2f2; color:#B23A3A; border:1px solid #fca5a5;';
    } finally {
      submitBtn.disabled = !(window as any)._turnstileToken;
      submitText.textContent = 'Enviar mensaje';
      submitIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />';
    }
  });
</script>
