---
const portalUrl = 'https://sga.sbn.cl/alumnos';
---

<section id="portal-alumnos" style="scroll-margin-top:90px; padding:clamp(72px,10vw,140px) 28px; background:var(--ink); border-top:1px solid #333;">
  <div style="max-width:1200px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:clamp(40px,6vw,100px); align-items:center;">

    <!-- Texto -->
    <div>
      <div style="font-size:13px; text-transform:uppercase; letter-spacing:.24em; color:var(--accent); font-weight:600;">
        Portal Académico
      </div>
      <h2 style="font-family:'Cormorant Garamond',serif; font-weight:600; font-size:clamp(2.3rem,4.5vw,3.6rem); line-height:1.05; letter-spacing:-0.01em; margin:22px 0 0; color:var(--bg);">
        Todo tu progreso académico en un solo lugar
      </h2>
      <p style="font-size:1.12rem; line-height:1.75; color:#A8A8A8; margin:24px 0 0;">
        Accede a tus cursos inscritos, revisa tus calificaciones, controla tu asistencia y mantente al día con las actividades del seminario desde cualquier dispositivo.
      </p>

      <ul style="list-style:none; padding:0; margin:32px 0 0; display:flex; flex-direction:column; gap:14px;">
        {[
          'Consulta tus notas y progreso por curso',
          'Revisa el calendario de sesiones y horarios',
          'Accede a tus inscripciones activas',
          'Descarga documentos y comprobantes',
        ].map((item) => (
          <li style="display:flex; align-items:flex-start; gap:12px; font-size:1.02rem; color:#C8C8C8; line-height:1.5;">
            <span style="color:var(--accent); margin-top:3px; flex-shrink:0;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </span>
            {item}
          </li>
        ))}
      </ul>

      <div style="margin-top:44px; display:flex; flex-wrap:wrap; gap:16px; align-items:center;">
        <a
          href={portalUrl}
          target="_blank"
          rel="noopener noreferrer"
          style="display:inline-flex; align-items:center; gap:10px; background:var(--accent); color:var(--accent-on); text-decoration:none; font-size:15px; font-weight:600; letter-spacing:.04em; padding:14px 28px; transition:opacity .2s;"
          onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'"
        >
          Ingresar al portal
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
        <span style="font-size:13px; color:#666;">Requiere cuenta de alumno activa</span>
      </div>
    </div>

    <!-- Panel decorativo -->
    <div style="position:relative; display:flex; flex-direction:column; gap:16px;">

      <!-- Card principal -->
      <div style="background:#2A2B28; border:1px solid #3A3B38; padding:28px 32px;">
        <div style="display:flex; align-items:center; gap:14px; margin-bottom:24px;">
          <div style="width:40px; height:40px; background:var(--accent-soft); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
          </div>
          <div>
            <div style="font-size:12px; text-transform:uppercase; letter-spacing:.16em; color:#666;">Mi avance</div>
            <div style="font-family:'Cormorant Garamond',serif; font-size:1.3rem; color:var(--bg); margin-top:2px;">Bachillerato en Teología</div>
          </div>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; border-top:1px solid #3A3B38; padding-top:20px;">
          {[
            { label: 'Cursos', valor: '12' },
            { label: 'Asistencia', valor: '94%' },
            { label: 'Promedio', valor: '6.2' },
          ].map(({ label, valor }) => (
            <div>
              <div style="font-size:11px; text-transform:uppercase; letter-spacing:.14em; color:#666;">{label}</div>
              <div style="font-family:'Cormorant Garamond',serif; font-size:2rem; color:var(--bg); margin-top:4px; line-height:1;">{valor}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Card secundaria -->
      <div style="background:#2A2B28; border:1px solid #3A3B38; padding:20px 32px; display:flex; justify-content:space-between; align-items:center;">
        <div>
          <div style="font-size:11px; text-transform:uppercase; letter-spacing:.16em; color:#666; margin-bottom:6px;">Próxima sesión</div>
          <div style="font-family:'Cormorant Garamond',serif; font-size:1.25rem; color:var(--bg);">Hermenéutica Bíblica</div>
          <div style="font-size:13px; color:#888; margin-top:4px;">Sábado · 09:00 — 12:00</div>
        </div>
        <div style="width:48px; height:48px; background:var(--accent); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  @media (max-width: 768px) {
    #portal-alumnos > div {
      grid-template-columns: 1fr !important;
    }
  }
</style>
